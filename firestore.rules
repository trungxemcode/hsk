rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/items/{itemId} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['id','time','writer','deleted','payload','updatedAt'])
    && request.resource.data.id is string && request.resource.data.id.size() < 1000
    && request.resource.data.time is number && request.resource.data.time >= 0
    && request.resource.data.writer is string && request.resource.data.writer.size() < 100
    && request.resource.data.deleted is bool
    && request.resource.data.payload is string && request.resource.data.payload.size() < 100000
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
 }
}
