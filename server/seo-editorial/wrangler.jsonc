{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "hsk-seo-editorial",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "SEO_BUCKET",
      "bucket_name": "hsk-music-library"
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "FIREBASE_API_KEY": "AIzaSyAQlltCY7fZzNUnVkaiOusYSwa0LO5a6ko",
    "ALLOWED_ORIGINS": "https://hskfreelearningai.pages.dev,https://trungxemcode.github.io",
    "PUBLISHED_ARTICLES_URL": "https://hskfreelearningai.pages.dev/content/seo-articles/articles.json",
    "MAX_PENDING_DRAFTS": "24",
    "CHATGPT_MAX_PER_HOUR": "2"
  }
}
