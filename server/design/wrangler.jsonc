    "PUBLIC_ORIGINS": "https://trungxemcode.github.io",
    "PUBLIC_URL": "https://trungxemcode.github.io/hsk/",
    "APP_RELEASE": "3.23.2"
  },
  "r2_buckets": [
    {
      "binding": "DESIGN_BUCKET",
      "bucket_name": "hsk-music-library"
    }
  ]
}
