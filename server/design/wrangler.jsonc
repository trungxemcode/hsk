{
  "name": "hsk-ui-designer",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
