FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server/music/source-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY server/music/source_resolver.py /app/source_resolver.py
USER nobody
CMD ["uvicorn", "source_resolver:app", "--host", "0.0.0.0", "--port", "8080"]
