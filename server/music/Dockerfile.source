FROM denoland/deno:bin-2.9.6 AS deno
FROM python:3.12-slim
COPY --from=deno /deno /usr/local/bin/deno
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server/music/source-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN deno --version && python -c "import yt_dlp, yt_dlp_ejs"
ENV DENO_DIR=/tmp/hsk-deno-cache
COPY server/music/source_resolver.py /app/source_resolver.py
USER nobody
CMD ["uvicorn", "source_resolver:app", "--host", "0.0.0.0", "--port", "8080"]
